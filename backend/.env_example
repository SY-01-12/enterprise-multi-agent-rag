# ============================================================
# 企业智能知识库 AI 助手 — 环境变量模板
# 复制为 .env 并填入实际值
# ============================================================

# ──────────────────────────────────────
# MySQL 配置（业务数据：用户/知识库/文档/会话）
# ──────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=langchain_rag
MYSQL_USER=rag_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# ──────────────────────────────────────
# Redis Stack 配置
# 角色: Checkpointer(短期记忆) + Store(长期记忆) + JWT黑名单 + 答案缓存
# 需要 Redis Stack (含 JSON + Search 模块)
# ──────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ──────────────────────────────────────
# Elasticsearch 配置（全文检索 BM25）
# ──────────────────────────────────────
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200

# ──────────────────────────────────────
# ChromaDB 配置（向量数据库）
# ──────────────────────────────────────
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# ──────────────────────────────────────
# 阿里百炼（LLM + Embedding + VL）
# 统一 API Key，覆盖: 对话/向量化/图片生成/OCR
# ──────────────────────────────────────
API_KEY=your_api_key_here
BASE_URL=https://dashscope.aliyuncs.com/api/v1
BASE_MODEL=qwen-turbo
BASE_EMBEDDING_MODEL=text-embedding-v3


# Vision / OCR 模型（图片理解、PDF 空白页 OCR、图片文件描述）
OCR_MODEL=qwen-vl-max

# ──────────────────────────────────────
# CrossEncoder 重排序模型（BGE 中文）
# ──────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base

# ──────────────────────────────────────
# Ollama 本地模型（可选）
# ──────────────────────────────────────
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3.5:4b

# ──────────────────────────────────────
# 热点答案缓存
# ──────────────────────────────────────
ANSWER_CACHE_TTL=3600

# ──────────────────────────────────────
# JWT 认证配置
# ──────────────────────────────────────
JWT_SECRET_KEY=your-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_TIME=30

# ──────────────────────────────────────
# 日志配置
# ──────────────────────────────────────
LOG_LEVEL=INFO
